# 網路監聽安全設定 (使用高埠位 54821)
#   internal : 自動綁定本機主機名解析到的叢集內網 IP (例 login-4 → LOGIN_4_IP)，不綁公網 IP (建議)
#   也可明確填入內網 IP；127.0.0.1 僅本機可連 (無法跨登入節點 SSH 轉發，也無法使用 OOD 代理)
HOST=internal
PORT=54821

# 對外連線方式 (SSH Tunnel 永遠可用；以下開關額外啟用 Open OnDemand /node/ 反向代理)
#   false : 僅 SSH Tunnel (原本方式)
#   true  : SSH Tunnel + OOD 代理 https://nano4.nchc.org.tw/node/<節點>/<PORT>/v1
#           (需 HOST=internal；客戶端須附 OnDemand 瀏覽器登入後的 mod_auth_openidc_session Cookie)
ENABLE_OOD_PROXY=false
OOD_SERVER=nano4.nchc.org.tw

# LiteLLM Proxy Master Key (由使用者自行產製)
LITELLM_MASTER_KEY=sk-your-litellm-master-key-here

# NCHC GenAI Portal API Key
NCHC_GENAI_API_KEY=sk-your-nchc-portal-key-here

# HPC 內部推論端點鑑權金鑰 (由 start.sh 自動自各引擎目錄 config.env 收集，此處可覆寫)
# 對應 sglang-qwen-27b/、sglang-qwen-flash/ 的 SGLANG_API_KEY
SGLANG_API_BASE=http://node-H:30000/v1
SGLANG_API_KEY=your_internal_sglang_secret_key

# 對應 vllm-deepseek-flash/ 的 VLLM_API_KEY (未設定時 start.sh 會自動自該目錄 config.env 載入)
VLLM_API_KEY=your_internal_vllm_secret_key

