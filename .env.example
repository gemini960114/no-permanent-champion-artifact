# 網路監聽安全設定 (僅監聽本機 127.0.0.1 避開內網掃描，使用高埠位 54821)
HOST=127.0.0.1
PORT=54821

# LiteLLM Proxy Master Key (由使用者自行產製)
LITELLM_MASTER_KEY=sk-your-litellm-master-key-here

# NCHC GenAI Portal API Key
NCHC_GENAI_API_KEY=sk-your-nchc-portal-key-here

# HPC 內部 SGLang Qwen 端點與鑑權金鑰 (由 start.sh 自動自 runtime/endpoints/ 合成動態配置)
SGLANG_API_BASE=http://node-H:30000/v1
SGLANG_API_KEY=your_internal_sglang_secret_key

