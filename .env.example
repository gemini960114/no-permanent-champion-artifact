# ============================================================
# LiteLLM Gateway 全域設定檔 (.env)
# ------------------------------------------------------------
# 設定檔分工原則 (哪個值該寫在哪裡)：
#   ① .env (本檔)            → 只放「全域」設定：埠位、管理金鑰、
#                              Portal 金鑰、對外連線開關
#   ② engines/<引擎>/config.env → 引擎私有設定：內部金鑰 (--api-key)、
#                              埠位、併發上限等；由 config.env.example
#                              複製，git 不追蹤
#   ③ runtime/endpoints/*.env → 引擎 Slurm job 啟動時自動發布的端點
#                              資訊 (節點 IP/PORT/別名)，隨 job 生滅
#   ④ config.runtime.yaml    → generator 依 ②③ 自動合成的路由表，
#                              勿手改
#
# 引擎金鑰覆寫優先序：本檔 (環境變數) > 各引擎 config.env
# ============================================================

# ── 1. 網路監聽 (安全設計：高埠位 + 只綁叢集內網 IP) ──
#   internal : 自動綁定本機主機名解析到的叢集內網 IP
#              (例 login-2 → LOGIN_2_IP)，不綁公網 IP (建議)；
#              跨登入節點 SSH 轉發與 OOD 代理皆可用
#   也可明確填入內網 IP；127.0.0.1 僅本機可連
#   (無法跨登入節點轉發，也無法使用 OOD 代理)
HOST=internal
PORT=54921

# ── 2. 對外連線開關 ──
# SSH Tunnel 與 VM 反向隧道永遠可用，不需任何設定；以下僅控制
# Open OnDemand /node/ 反向代理：
#   false : 不啟用
#   true  : 加啟用 https://<OOD_SERVER>/node/<節點>/<PORT>/v1
#           (需 HOST=internal；客戶端須附 OnDemand 瀏覽器登入後的
#            mod_auth_openidc_session Cookie)
ENABLE_OOD_PROXY=false
OOD_SERVER=nano4.nchc.org.tw

# ── 3. 必要金鑰 ──
# LiteLLM Master Key：最高管理權限 (config.yaml general_settings 引用，
# 缺少此值 Gateway 無法啟動)。由 install.sh 自動產製或自行產生。
LITELLM_MASTER_KEY=sk-your-litellm-master-key-here

# NCHC GenAI Portal 金鑰：GLM-5.2 / Kimi-K3 / gemma-4-31B-it 等
# Portal 模型的唯一金鑰來源 (至國網 Portal 申請)。
NCHC_GENAI_API_KEY=sk-your-nchc-portal-key-here

# ── 4. 引擎內部金鑰 (選填覆寫；常規情況請勿設定) ──
# 常規流程：start.sh 自動收集 engines/*/config.env 內的
# SGLANG_API_KEY / VLLM_API_KEY，本檔不需設任何引擎金鑰。
# 僅當你要「以單一金鑰覆寫所有同類引擎」時才取消註解，且值必須與
# 引擎實際啟動的 --api-key 一致 (不一致 → 探測 401、該引擎被略過)。
# SGLANG_API_KEY=your_internal_sglang_secret_key
# VLLM_API_KEY=your_internal_vllm_secret_key

# ⚠️ 已淘汰變數 (勿再使用)：
#   SGLANG_API_BASE / SGLANG_FLASH_API_BASE / VLLM_DEEPSEEK_API_BASE
#   等手寫引擎位址——引擎位址現由 runtime/endpoints/ 自動發布、
#   generator 自動合成；手寫值只有 generate_runtime_config.py
#   不存在時的 config.yaml 靜態 fallback 會讀 (非常態路徑)。
