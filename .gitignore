# ==============================================================================
# LiteLLM HPC Proxy & SGLang 服務 - Git 忽略規則檔 (.gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 機密憑證、API 金鑰與環境變數 (重要：嚴禁上傳任何真實密鑰)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
config.env
**/config.env
!config.env.example
!**/config.env.example
api_keys.json
**/api_keys.json
api_keys.json.lock
**/api_keys.json.lock
api_keys.json.tmp.*
**/api_keys.json.tmp.*
# 客戶端連線設定 (含 API Key 與 OnDemand Session Cookie)
client/*.env

# API Token、憑據檔與金鑰備份
*token*
*.token
hf_token*
huggingface_token
*secret*
*credential*

# SSL / TLS 憑證與私鑰 (供 Caddy / Nginx Gateway 等使用)
*.key
*.pem
*.crt
*.cert
*.p12
*.pfx
*.csr

# SSH 金鑰與主機認證檔 (防止 Tunnel 自動連線金鑰誤傳)
id_rsa*
id_ed25519*
known_hosts
*.pub

# ------------------------------------------------------------------------------
# 2. 運行日誌、SLURM 輸出檔與除錯追蹤 (防止暴露內部 IP、路徑或除錯資訊)
# ------------------------------------------------------------------------------
*.log
**/*.log
*.out
**/*.out
*.err
**/*.err
nohup.out
logs/
**/logs/
slurm-*.out
slurm-*.err

# 核心傾印與除錯效能分析追蹤 (Core Dumps & Profiling Traces)
core
core.[0-9]*
*.trace
*.prof
*.profile
*.nsys-rep
*.qdrep

# ------------------------------------------------------------------------------
# 3. 動態節點端點、進程鎖與通訊 Socket
# ------------------------------------------------------------------------------
endpoint.info
**/endpoint.info
runtime/
**/runtime/
config.runtime.yaml
*.pid
**/*.pid
.litellm.pid
.litellm_node
*.sock
*.socket
*.lock
*.lck
*.filelock

# ------------------------------------------------------------------------------
# 4. 資料庫檔案 (LiteLLM Proxy 本機 SQLite 或暫存 DB)
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.dump
*.sql

# ------------------------------------------------------------------------------
# 5. 大型模型權重、容器映像檔、下載快取與大型壓縮檔 (防止大檔案塞爆 Git)
# ------------------------------------------------------------------------------
models/
**/models/
huggingface_cache/
hf_cache/
model_cache/
weights/
sglang_storage/
.cache/
*.sif
*.sandbox/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.parquet
*.arrow

# ------------------------------------------------------------------------------
# 6. Python 虛擬環境、編譯快取與套件打包
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 7. 作業系統、編輯器暫存與本機歷史紀錄
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
.vscode/
.idea/
.history/
*.sublime-project
*.sublime-workspace
.bash_history

# agent 環境專屬設定（本機）
.claude/
.roo/

# LaTeX 產物（保留 PDF，其餘 build 產物忽略）
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
