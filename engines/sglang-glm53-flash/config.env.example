# ==============================================================================
# SGLang GLM-5.3-Flash 服務設定範本檔 (config.env.example)
# 配方：官方 cookbook H200 8-GPU Low Latency（EAGLE MTP 5-1-6）
# ==============================================================================

# 1. SLURM 叢集資源設定 (8x H200 GPU, TP=8, EP=8)
# ⚠️ 官方僅提供 H200 8-GPU 配方（無 4-GPU）；321B MoE / 18B 激活
SLURM_ACCOUNT=your-slurm-account
SLURM_PARTITION=8gpus
SLURM_GPUS=8
SLURM_CPUS=96
SLURM_MEM=480G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
# 與 sglang-qwen-flash 共用同一 image：SGLang 0.5.20（官方要求 ≥0.5.20）
# 2026-09-26 實測：glm5_next.py / glm5_next_nextn.py / glm45 parser / glm47
# tool-call detector / tilelang 0.1.12 / deep_gemm / EAGLE 皆在 image 內
SIF_PATH=/path/to/work/containers/sglang_0.5.20.sif
CONTAINER_IMAGE=docker://lmsysorg/sglang:latest
MODELS_DIR=/path/to/work/models
HF_CACHE_DIR=/path/to/work/huggingface_cache
HF_TOKEN=your_huggingface_token_here

# 3. 模型名稱與路徑（原生 FP8 checkpoint，328.3GB，62 分片，非 gated，MIT 授權）
MODEL_NAME=zai-org/GLM-5.3-Flash
MODEL_ALIAS=glm5.3-flash

# 4. SGLang 服務與高階推論參數（官方 H200 Low Latency 配方）
PORT=35000
HOST=0.0.0.0
HEALTH_TIMEOUT=2400
TP=8
EP=8
# 官方 Low Latency 配方值（H200 上 BF16 KV + TileLang DSA；FP8 KV 於 Hopper 不支援）
MEM_FRACTION=0.75
KV_CACHE_DTYPE=bfloat16
DSA_PREFILL_BACKEND=tilelang
DSA_DECODE_BACKEND=tilelang
MOE_RUNNER_BACKEND=deep_gemm
# parser 用 auto：SGLang 自動解析為 glm45 (reasoning) / glm47 (tool-call)
REASONING_PARSER=auto
TOOL_CALL_PARSER=auto
# 投機解碼：官方 MTP 配方 EAGLE 5-1-6；改 High Throughput 策略時整段註解掉
SPECULATIVE_ALGORITHM=EAGLE
SPECULATIVE_NUM_STEPS=5
SPECULATIVE_EAGLE_TOPK=1
SPECULATIVE_NUM_DRAFT_TOKENS=6

# 5. SGLang 內部 API 鑑權保護
SGLANG_API_KEY=your_sglang_internal_key_here
API_KEY_ENV=SGLANG_API_KEY

# 6. 併發解碼上限 (選填)：上線後依記憶體餘量實測調優（比照 flash 48→100 經驗）
# MAX_RUNNING_REQUESTS=64
