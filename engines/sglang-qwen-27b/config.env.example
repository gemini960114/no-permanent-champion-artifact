# ==============================================================================
# SGLang Qwen3.8-27B 服務設定範例檔 (config.env.example)
# 使用方式：cp config.env.example config.env 並填入您的設定與 Token
# ==============================================================================

# 1. SLURM 叢集資源設定 (1 Core H200 GPU)
SLURM_ACCOUNT=your-slurm-account
SLURM_PARTITION=8gpus          # 或可選 dev (測試分區)
SLURM_GPUS=1                  # 1 Core H200 GPU
SLURM_CPUS=12                 # 搭配 12 CPU Cores
SLURM_MEM=120G                # 搭配 120GB 記憶體
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=/path/to/work/containers/sglang_0.5.19.sif
MODELS_DIR=/path/to/work/models
HF_CACHE_DIR=/path/to/work/huggingface_cache

# HuggingFace 授權 Token (請替換為您的 HF Token)
HF_TOKEN=your_huggingface_token_here

# 3. 模型名稱與路徑
MODEL_NAME=Qwen/Qwen3.8-27B-FP8
FALLBACK_MODEL_NAME=Qwen/Qwen3.8-27B

# 4. SGLang 服務參數
PORT=30000
HOST=0.0.0.0
# 健康自檢逾時 (秒)：超過此時間仍未就緒，Job 會自動 scancel 釋放 GPU，避免無限期佔卡
HEALTH_TIMEOUT=600
KV_CACHE_DTYPE=fp8_e4m3
MEM_FRACTION=0.85
ATTENTION_BACKEND=flashinfer
CHUNKED_PREFILL_SIZE=32768
MAX_PREFILL_TOKENS=32768
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
MAMBA_FULL_MEMORY_RATIO=4.59
MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
MAMBA_SSM_DTYPE=float32

# 5. SGLang 內部 API 鑑權保護 (防止同 HPC 內網他人未授權存取 H200)
# 建議設定高強度隨機字串，LiteLLM 會讀取同名變數自動帶入 Authorization Bearer
SGLANG_API_KEY=your_internal_sglang_secret_key

