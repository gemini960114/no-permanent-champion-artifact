# ==============================================================================
# SGLang Step-5-Preview-FP8 服務設定範本檔 (config.env.example)
# ⚠️ 狀態：準備中——官方 FP8 權重尚未釋出 (BF16 版 1.21TB 超出本叢集單節點容量)
#    釋出後：cp config.env.example config.env → 填金鑰 → ./download_model.sh
# ==============================================================================

# 1. SLURM 叢集資源設定 (8x H200 GPU, TP=8, EP=8)
# 604B MoE：FP8 權重約 604GB，需 8×H200 (1,128GB) 容納權重 + KV cache
SLURM_ACCOUNT=your-slurm-account
SLURM_PARTITION=8gpus
SLURM_GPUS=8
SLURM_CPUS=96
SLURM_MEM=480G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
# 與 sglang-qwen-flash 共用同一 image：SGLang 0.5.20 已內建 step3p5.py 原生支援
# (2026-09-26 實測：apptainer exec ... ls srt/models | grep step → step3p5.py, step3p5_mtp.py)
SIF_PATH=/path/to/work/containers/sglang_flash_latest.sif
CONTAINER_IMAGE=docker://lmsysorg/sglang:latest
MODELS_DIR=/path/to/work/models
HF_CACHE_DIR=/path/to/work/huggingface_cache
HF_TOKEN=your_huggingface_token_here

# 3. 模型名稱與路徑
# 官方 FP8 版釋出時請確認實際 repo 名（原版為 SHSLab，TypeSafeAI 為鏡像）
MODEL_NAME=TypeSafeAI/Step-5-Preview-FP8
FALLBACK_MODEL_NAME=SHSLab/Step-5-Preview-FP8
MODEL_ALIAS=step5-preview

# 4. SGLang 服務與高階推論參數
PORT=34000
HOST=0.0.0.0
# 健康自檢逾時 (秒)：超過此時間仍未就緒，Job 會自動 scancel 釋放 GPU。
# 604GB 權重載入 + CUDA Graph 暖機，保守設定
HEALTH_TIMEOUT=2400
TP=8
EP=8
MEM_FRACTION=0.90
CHUNKED_PREFILL_SIZE=8192
# 官方宣稱 1M context，但 KV cache 不允許——先 256K 起步，穩定後視記憶體餘量調升
CONTEXT_LENGTH=262144
# Step-5 思維鏈解析器
# ⚠️ 2026-09-26 實測：model card 寫 --reasoning-parser stepfun，但 SGLang 0.5.20
#    的合法選項 (ReasoningParser.DetectorMap) 中沒有 "stepfun"，對應值為 "step3p5"
#    (架構名)。照抄 model card 指令會導致 server 啟動失敗。
REASONING_PARSER=step3p5

# 5. SGLang 內部 API 鑑權保護
SGLANG_API_KEY=your_sglang_internal_key_here
API_KEY_ENV=SGLANG_API_KEY

# 6. 併發解碼上限 (選填)：上線後依記憶體餘量實測調優 (比照 flash 的 48→100 調優經驗)
# MAX_RUNNING_REQUESTS=64

# 7. (未來實驗) MTP 投機解碼：image 內含 step3p5_mtp.py，俟官方參數確認後
#    於 sglang_server.slurm 加入 --speculative-algorithm 等參數
