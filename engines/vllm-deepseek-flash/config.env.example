# ==============================================================================
# vLLM DeepSeek-V4.1-Flash 服務設定範本 (config.env.example)
# ==============================================================================

# 1. SLURM 叢集資源設定 (2x H200 GPU, TP=2)
SLURM_ACCOUNT=your-slurm-account
SLURM_PARTITION=8gpus
SLURM_GPUS=2
SLURM_CPUS=24
SLURM_MEM=180G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=/path/to/work/containers/vllm_latest.sif
MODELS_DIR=/path/to/work/models
HF_CACHE_DIR=/path/to/work/huggingface_cache
HF_TOKEN=your_huggingface_token_here

# 3. 模型名稱與路徑
MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash
FALLBACK_MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash
MODEL_ALIAS=deepseek-v4-flash

# 4. vLLM 服務與高階推論參數
PORT=33000
HOST=0.0.0.0
# 健康自檢逾時 (秒)：超過此時間仍未就緒，Job 會自動 scancel 釋放 GPU，避免無限期佔卡。
# DeepSeek 啟用 CPU offload，首次啟動載入較慢，建議保守設定
HEALTH_TIMEOUT=1800
TENSOR_PARALLEL_SIZE=2
TOKENIZER_MODE=deepseek_v41
ATTENTION_CONFIG='{"backend":"FLASHINFER_MLA_SPARSE_DSV41","indexer_kv_dtype":"mxfp4","indexer_sparse_logits":true}'
KV_CACHE_DTYPE=fp8
MAX_NUM_SEQS=128
ENGRAM_CONFIG='{"cpu_offload":true}'
TOOL_CALL_PARSER=deepseek_v41
REASONING_PARSER=deepseek_v41
MM_ENCODER_TP_MODE=data

# 5. API 內部鑑權金鑰保護
VLLM_API_KEY=your_vllm_internal_key_here
API_KEY_ENV=VLLM_API_KEY
