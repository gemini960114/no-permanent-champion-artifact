# ==============================================================================
# vLLM Qwen3.8-27B 服務設定檔範本 (config.env.example)
# 複製為 config.env 後填入真實金鑰；參數依官方 vLLM Recipe 設定
# ==============================================================================

# 1. SLURM 叢集資源設定 (1x H200 GPU, TP=1)
SLURM_ACCOUNT=your-slurm-account
SLURM_PARTITION=8gpus
SLURM_GPUS=1
SLURM_CPUS=12
SLURM_MEM=120G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=/path/to/work/containers/vllm_latest.sif
MODELS_DIR=/path/to/work/models
HF_CACHE_DIR=/path/to/work/huggingface_cache

# HuggingFace 授權 Token
HF_TOKEN=hf_your_token_here

# 3. 模型名稱與路徑（-vLLM 後綴用於 Gateway 路由隔離）
MODEL_NAME=Qwen/Qwen3.8-27B-vLLM
FALLBACK_MODEL_NAME=Qwen/Qwen3.8-27B
MODEL_ALIAS=qwen-27b-vllm

# 4. vLLM 服務參數（官方 Recipe）
PORT=36000
HOST=0.0.0.0
TENSOR_PARALLEL_SIZE=1
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=128
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml

# 投機解碼（官方 MTP；R2 壓測時取消註解）
#SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":3}

# 5. API 內部鑑權金鑰保護（openssl rand -hex 16 產生）
VLLM_API_KEY=sk-vllm-qwen27b-your-key-here
API_KEY_ENV=VLLM_API_KEY

# 健康自檢逾時 (秒)
HEALTH_TIMEOUT=1800
