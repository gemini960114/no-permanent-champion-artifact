# ==============================================================================
# SGLang Qwen3.8-Flash-Next 服務設定範本檔 (config.env.example)
# ==============================================================================

# 1. SLURM 叢集資源設定 (4x H200 GPU, TP=4, EP=4)
SLURM_ACCOUNT=your-slurm-account
SLURM_PARTITION=8gpus
SLURM_GPUS=4
SLURM_CPUS=48
SLURM_MEM=240G
SLURM_TIME="24:00:00"

# 2. 容器與模型路徑
SIF_PATH=/path/to/work/containers/sglang_flash_latest.sif
CONTAINER_IMAGE=docker://lmsysorg/sglang:qwen38flashnext
MODELS_DIR=/path/to/work/models
HF_CACHE_DIR=/path/to/work/huggingface_cache
HF_TOKEN=your_huggingface_token_here

# 3. 模型名稱與路徑
MODEL_NAME=Qwen/Qwen3.8-Flash-Next-FP8
FALLBACK_MODEL_NAME=Qwen/Qwen3.8-Flash-Next
MODEL_ALIAS=qwen3.8-flash

# 4. SGLang 服務與高階推論參數
PORT=32000
HOST=0.0.0.0
TP=4
EP=4
MEM_FRACTION=0.85
CHUNKED_PREFILL_SIZE=8192
LINEAR_ATTN_PREFILL_BACKEND=flashinfer
LINEAR_ATTN_DECODE_BACKEND=flashinfer
LINEAR_ATTN_VERIFY_BACKEND=triton
MAMBA_SSM_DTYPE=bfloat16
SPECULATIVE_ALGORITHM=NEXTN
SPECULATIVE_NUM_STEPS=3
SPECULATIVE_EAGLE_TOPK=1
SPECULATIVE_NUM_DRAFT_TOKENS=4
REASONING_PARSER=auto

# 5. SGLang 內部 API 鑑權保護
SGLANG_API_KEY=your_sglang_internal_key_here
API_KEY_ENV=SGLANG_API_KEY
